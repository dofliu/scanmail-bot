# ── Gemini Vision API ──
GEMINI_API_KEY=
AI_MODEL=gemini-2.0-flash
AI_MAX_TOKENS=1024
AI_TEMPERATURE=0.3

# ── SMTP ──
SMTP_HOST=mail.ncut.edu.tw
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ── 預設寄件人 ──
SENDER_NAME=劉瑞弘
SENDER_TITLE=副教授
SENDER_DEPT=智慧自動化工程系
SENDER_ORG=國立勤益科技大學

# ── 應用設定 ──
DATABASE_PATH=scanmail.db
SESSION_TIMEOUT_MINUTES=30
MAX_IMAGE_SIZE_MB=10
LOG_LEVEL=INFO

# ── CORS（逗號分隔；對外部署請收斂為實際網域）──
# Android App 的 WebView 來源是 https://localhost，收斂時要記得一併加入，
# 例如：ALLOWED_ORIGINS=https://localhost,https://scanmail.example.com
ALLOWED_ORIGINS=*

# ── 加密金鑰（正式部署務必設定獨立值）──
ENCRYPTION_KEY=your-secret-key-here

# ── 使用者認證 ──
# False（預設）＝ 單人模式，以 X-User-Id header 識別，不驗證。
# True ＝ 多使用者模式，要登入拿 Token。**開這個之前一定要先設好上面的
# ENCRYPTION_KEY** —— 用公開的預設值會讓 Token 可以被任意偽造，服務會拒絕啟動。
ENABLE_AUTH=False

# 簽發身分 Token 用的金鑰。留空＝從 ENCRYPTION_KEY 推導（位元組跟 SMTP 那把不同）。
# 單獨設定它的用途是「換一把就把所有人踢下線」，不必動 SMTP 那把。
AUTH_SECRET_KEY=

# 註冊邀請碼。留空時註冊只開放給**第一個**帳號，之後自動關閉；
# 要加人就設一個碼、把碼給對方，加完再拿掉。
REGISTRATION_TOKEN=

# 登入 Cookie 的 Secure 旗標。留空＝跟著請求的 scheme 走（https 帶、http 不帶）。
# 反向代理後面 scheme 會是 http，那種部署請明確設成 true。
COOKIE_SECURE=
